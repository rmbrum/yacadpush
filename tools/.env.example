# Copy to tools/.env and fill in. NEVER commit the real .env file.

# --- ieee_to_zenodo.py ---
IEEE_API_KEY=
ZENODO_TOKEN=
# Use the sandbox while testing: https://sandbox.zenodo.org (separate account + token)
ZENODO_SANDBOX=true
# Optional, comma-separated Zenodo community slugs
ZENODO_COMMUNITIES=

# --- json_to_db.py ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
